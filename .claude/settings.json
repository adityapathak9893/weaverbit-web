{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post-edit-verify.sh\"",
            "timeout": 120,
            "statusMessage": "Typecheck + lint on edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop-gate.sh\"",
            "timeout": 600,
            "statusMessage": "Running definition-of-done gates"
          }
        ]
      }
    ]
  }
}
